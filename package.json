{
  "name": "codex-channel-bridge",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "taskboard"
  ],
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "description": "Local OpenAI Codex bridge for WeChat, Enterprise WeChat, and Feishu.",
  "license": "MIT",
  "author": "Xuechao Zou",
  "homepage": "https://github.com/lsiten/codex-channel-bridge#readme",
  "bugs": {
    "url": "https://github.com/lsiten/codex-channel-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsiten/codex-channel-bridge.git"
  },
  "keywords": [
    "codex",
    "wechat",
    "weixin",
    "openai",
    "bridge"
  ],
  "type": "module",
  "workspaces": [
    "taskboard"
  ],
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "scripts": {
    "install:local": "node scripts/install-local.mjs",
    "install:check": "node scripts/install-local.mjs --check",
    "build": "npm run build:bridge && npm run build:taskboard",
    "build:bridge": "tsc -p tsconfig.json && npm run copy:web",
    "build:taskboard": "npm run build:web --workspace=codex-taskboard",
    "copy:web": "node scripts/copy-web-assets.mjs",
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['dist','taskboard/dist']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "dev": "tsx src/server/index.ts",
    "dev:taskboard": "npm run dev --workspace=codex-taskboard",
    "taskboard:check": "npm run check --workspace=codex-taskboard",
    "taskboard:codex": "npm run codex --workspace=codex-taskboard",
    "taskboard:inject": "npm run codex:inject --workspace=codex-taskboard",
    "taskboard:start": "npm run start --workspace=codex-taskboard",
    "taskboard:taskctl": "npm run taskctl --workspace=codex-taskboard --",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "dompurify": "^3.4.12",
    "lucide": "^0.468.0",
    "marked": "^18.0.6",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
